# ==========================================
# Main Backend — Environment Configuration
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000

# Database Configuration (PostgreSQL / Supabase)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/iot_irrigation?schema=public"

# Authentication & JWT Secrets
# Generate random 64-char strings for production
JWT_ACCESS_SECRET="your-super-secret-access-token-key-change-in-production"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="your-super-secret-refresh-token-key-change-in-production"
JWT_REFRESH_EXPIRES_IN="7d"

# MQTT Broker Configuration (Eclipse Mosquitto)
MQTT_BROKER_URL="mqtt://localhost:1883"
MQTT_CLIENT_ID="iot-irrigation-backend-service"
MQTT_USERNAME=""
MQTT_PASSWORD=""

# AI Service Configuration (Python + FastAPI)
AI_SERVICE_BASE_URL="http://localhost:8000"
AI_SERVICE_API_KEY="your-ai-service-api-key-here"
AI_SERVICE_TIMEOUT_MS=10000

# Logging Configuration (Pino)
# Options: fatal, error, warn, info, debug, trace
LOG_LEVEL="info"

