// Prisma schema untuk Main Backend Project 3
// Database: PostgreSQL
// Catatan:
// - Constraint CHECK, partial unique index, dan beberapa constraint khusus
//   perlu ditambahkan melalui SQL migration manual.
// - Jangan menghapus data historis secara fisik; gunakan status aktif/nonaktif.
// - Semua timestamp disimpan sebagai timestamptz UTC.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  PETUGAS_LAPANGAN
  PENGELOLA
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum DeviceConnectionStatus {
  ONLINE
  OFFLINE
}

enum SensorType {
  RAINFALL
  WATER_LEVEL
}

enum TelemetryValidityStatus {
  NORMAL
  ANOMALY
}

enum GateOperationalStatus {
  NORMAL
  MOVING
  ERROR
  OFFLINE
}

enum GateCommandType {
  OPEN
  CLOSE
  SET_PERCENTAGE
}

enum GateCommandSource {
  MANUAL
  AI_RECOMMENDATION
}

enum GateCommandStatus {
  PENDING
  APPROVED
  SENT
  EXECUTED
  CANCELLED
  FAILED
  TIMEOUT
}

enum GateCommandFailureType {
  DELIVERY_FAILED
  EXECUTION_FAILED
}

enum GateOperationFinalStatus {
  EXECUTED
  FAILED
  TIMEOUT
}

enum GateCommandEventType {
  COMMAND_SENT
  DELIVERY_ACKNOWLEDGED
  GATE_MOVING
  EXECUTION_SUCCEEDED
  EXECUTION_FAILED
  DELIVERY_FAILED
  RETRY_ATTEMPTED
  COMMAND_TIMEOUT
}

enum PredictionType {
  RAINFALL
  WATER_LEVEL
}

enum RiskLevel {
  NORMAL
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum WarningType {
  ACTUAL
  PREDICTION
}

enum WarningStatus {
  ACTIVE
  ACKNOWLEDGED
  RESOLVED
}

enum ThresholdOperator {
  GT
  GTE
  LT
  LTE
}

enum RecommendationStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

model User {
  id        String     @id @default(uuid()) @db.Uuid
  name      String     @db.VarChar(150)
  email     String     @unique @db.VarChar(255)
  phone     String?    @db.VarChar(30)
  role      UserRole
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  authAccounts          AuthAccount[]
  sessions              Session[]
  invitationsCreated    Invitation[]       @relation("InvitationCreator")
  devicesCreated        Device[]           @relation("DeviceCreator")
  credentialsCreated    DeviceCredential[] @relation("CredentialCreator")
  gateCommandsCreated   GateCommand[]      @relation("GateCommandCreator")
  gateCommandsApproved  GateCommand[]      @relation("GateCommandApprover")
  warningsAcknowledged  Warning[]          @relation("WarningAcknowledger")
  recommendationsCreated Recommendation[]  @relation("RecommendationCreator")
  recommendationsReviewed Recommendation[] @relation("RecommendationReviewer")
  warningRulesCreated   WarningRule[]      @relation("WarningRuleCreator")
  warningRulesUpdated   WarningRule[]      @relation("WarningRuleUpdater")
  auditLogs             AuditLog[]
  runtimeConfigsUpdated RuntimeConfig[]

  @@map("users")
}

model AuthAccount {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  provider       AuthProvider
  providerUserId String       @map("provider_user_id") @db.VarChar(255)
  passwordHash   String?      @map("password_hash") @db.VarChar(255)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("auth_accounts")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @map("refresh_token_hash") @db.VarChar(255)
  ipAddress        String?   @map("ip_address") @db.VarChar(64)
  userAgent        String?   @map("user_agent") @db.Text
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

model Invitation {
  id        String    @id @default(uuid()) @db.Uuid
  email     String    @db.VarChar(255)
  name      String    @db.VarChar(150)
  role      UserRole
  tokenHash String    @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz(6)
  createdBy String    @map("created_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  creator User @relation("InvitationCreator", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([email])
  @@index([expiresAt, acceptedAt])
  @@map("invitations")
}

model Device {
  id               String                 @id @default(uuid()) @db.Uuid
  deviceCode       String                 @unique @map("device_code") @db.VarChar(50)
  name             String                 @db.VarChar(150)
  description      String?                @db.Text
  location         String                 @db.VarChar(255)
  connectionStatus DeviceConnectionStatus @default(OFFLINE) @map("connection_status")
  isActive         Boolean                @default(true) @map("is_active")
  lastSeenAt       DateTime?              @map("last_seen_at") @db.Timestamptz(6)
  createdBy        String                 @map("created_by") @db.Uuid
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  creator          User               @relation("DeviceCreator", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Cascade)
  credentials      DeviceCredential[]
  sensors          Sensor[]
  telemetryReadings TelemetryReading[]
  gate             Gate?

  @@index([connectionStatus, isActive])
  @@map("devices")
}

model DeviceCredential {
  id        String    @id @default(uuid()) @db.Uuid
  deviceId  String    @map("device_id") @db.Uuid
  secretHash String   @map("secret_hash") @db.VarChar(255)
  createdBy String    @map("created_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  expiresAt DateTime? @map("expires_at") @db.Timestamptz(6)

  device  Device @relation(fields: [deviceId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  creator User   @relation("CredentialCreator", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([deviceId, revokedAt])
  @@index([expiresAt])
  @@map("device_credentials")
}

model Sensor {
  id         String     @id @default(uuid()) @db.Uuid
  deviceId   String     @map("device_id") @db.Uuid
  sensorCode String     @unique @map("sensor_code") @db.VarChar(50)
  name       String     @db.VarChar(150)
  type       SensorType
  parameter  String     @db.VarChar(100)
  unit       String     @db.VarChar(30)
  isActive   Boolean    @default(true) @map("is_active")
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  device           Device            @relation(fields: [deviceId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  telemetryReadings TelemetryReading[]
  predictions      Prediction[]
  warnings         Warning[]

  // Dibutuhkan sebagai target composite foreign key telemetry_readings.
  @@unique([id, deviceId])
  @@index([deviceId, isActive])
  @@map("sensors")
}

model TelemetryReading {
  id             String                 @id @default(uuid()) @db.Uuid
  messageId      String                 @unique @map("message_id") @db.VarChar(100)
  deviceId       String                 @map("device_id") @db.Uuid
  sensorId       String                 @map("sensor_id") @db.Uuid
  measuredAt     DateTime               @map("measured_at") @db.Timestamptz(6)
  receivedAt     DateTime               @default(now()) @map("received_at") @db.Timestamptz(6)
  value          Float                  @db.DoublePrecision
  unit           String                 @db.VarChar(30)
  validityStatus TelemetryValidityStatus @default(NORMAL) @map("validity_status")

  device Device @relation(fields: [deviceId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sensor Sensor @relation(fields: [sensorId, deviceId], references: [id, deviceId], onDelete: Restrict, onUpdate: Cascade)

  @@index([sensorId, measuredAt])
  @@index([deviceId, measuredAt])
  @@index([receivedAt])
  @@index([validityStatus, measuredAt])
  @@map("telemetry_readings")
}

model Gate {
  id                String                @id @default(uuid()) @db.Uuid
  gateCode          String                @unique @map("gate_code") @db.VarChar(50)
  deviceId          String                @unique @map("device_id") @db.Uuid
  name              String                @db.VarChar(150)
  location          String                @db.VarChar(255)
  actualOpening     Decimal               @default(0) @map("actual_opening") @db.Decimal(5, 2)
  operationalStatus GateOperationalStatus @default(OFFLINE) @map("operational_status")
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  device          Device           @relation(fields: [deviceId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  commands        GateCommand[]
  operationLogs   GateOperationLog[]
  recommendations Recommendation[]

  @@map("gates")
}

model GateCommand {
  id              String                  @id @default(uuid()) @db.Uuid
  gateId          String                  @map("gate_id") @db.Uuid
  commandType     GateCommandType         @map("command_type")
  targetOpening   Decimal                 @map("target_opening") @db.Decimal(5, 2)
  source          GateCommandSource
  recommendationId String?                @unique @map("recommendation_id") @db.Uuid
  status          GateCommandStatus       @default(PENDING)
  failureType     GateCommandFailureType? @map("failure_type")
  failureReason   String?                 @map("failure_reason") @db.Text
  createdBy       String                  @map("created_by") @db.Uuid
  approvedBy      String?                 @map("approved_by") @db.Uuid
  approvedAt      DateTime?               @map("approved_at") @db.Timestamptz(6)
  sentAt          DateTime?               @map("sent_at") @db.Timestamptz(6)
  completedAt     DateTime?               @map("completed_at") @db.Timestamptz(6)
  retryCount      Int                     @default(0) @map("retry_count")
  lastRetryAt     DateTime?               @map("last_retry_at") @db.Timestamptz(6)
  createdAt       DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)

  gate           Gate           @relation(fields: [gateId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  recommendation Recommendation? @relation(fields: [recommendationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  creator        User           @relation("GateCommandCreator", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Cascade)
  approver       User?          @relation("GateCommandApprover", fields: [approvedBy], references: [id], onDelete: Restrict, onUpdate: Cascade)
  operationLog   GateOperationLog?
  events         GateCommandEvent[]

  @@index([gateId, createdAt])
  @@index([status, createdAt])
  @@map("gate_commands")
}

model GateOperationLog {
  id             String                   @id @default(uuid()) @db.Uuid
  commandId      String                   @unique @map("command_id") @db.Uuid
  gateId         String                   @map("gate_id") @db.Uuid
  previousOpening Decimal?                @map("previous_opening") @db.Decimal(5, 2)
  targetOpening  Decimal                  @map("target_opening") @db.Decimal(5, 2)
  actualOpening  Decimal?                 @map("actual_opening") @db.Decimal(5, 2)
  startedAt      DateTime?                @map("started_at") @db.Timestamptz(6)
  completedAt    DateTime                 @map("completed_at") @db.Timestamptz(6)
  finalStatus    GateOperationFinalStatus @map("final_status")
  createdAt      DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)

  command GateCommand @relation(fields: [commandId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  gate    Gate        @relation(fields: [gateId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([gateId, completedAt])
  @@map("gate_operation_logs")
}

model GateCommandEvent {
  id          String                @id @default(uuid()) @db.Uuid
  commandId   String                @map("command_id") @db.Uuid
  eventType   GateCommandEventType  @map("event_type")
  description String                @db.Text
  payload     Json?
  occurredAt  DateTime              @map("occurred_at") @db.Timestamptz(6)
  receivedAt  DateTime              @default(now()) @map("received_at") @db.Timestamptz(6)
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  command GateCommand @relation(fields: [commandId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([commandId, occurredAt])
  @@map("gate_command_events")
}

model Prediction {
  id             String         @id @default(uuid()) @db.Uuid
  sensorId       String         @map("sensor_id") @db.Uuid
  predictionType PredictionType @map("prediction_type")
  predictedValue Float          @map("predicted_value")
  unit           String         @db.VarChar(30)
  predictedAt    DateTime       @map("predicted_at") @db.Timestamptz(6)
  forecastFor    DateTime       @map("forecast_for") @db.Timestamptz(6)
  riskLevel      RiskLevel      @map("risk_level")
  modelVersion   String         @map("model_version") @db.VarChar(100)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  sensor   Sensor    @relation(fields: [sensorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  warnings Warning[]

  @@index([sensorId, forecastFor])
  @@index([predictedAt])
  @@map("predictions")
}

model Warning {
  id               String        @id @default(uuid()) @db.Uuid
  warningType      WarningType   @map("warning_type")
  sensorId         String?       @map("sensor_id") @db.Uuid
  predictionId     String?       @map("prediction_id") @db.Uuid
  riskLevel        RiskLevel     @map("risk_level")
  title            String        @db.VarChar(200)
  description      String        @db.Text
  status           WarningStatus @default(ACTIVE)
  acknowledgedBy   String?       @map("acknowledged_by") @db.Uuid
  acknowledgedAt  DateTime?     @map("acknowledged_at") @db.Timestamptz(6)
  firstOccurredAt  DateTime      @map("first_occurred_at") @db.Timestamptz(6)
  lastUpdatedAt    DateTime      @map("last_updated_at") @db.Timestamptz(6)
  resolvedAt       DateTime?     @map("resolved_at") @db.Timestamptz(6)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  sensor       Sensor?     @relation(fields: [sensorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  prediction   Prediction? @relation(fields: [predictionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  acknowledger User?       @relation("WarningAcknowledger", fields: [acknowledgedBy], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([status, createdAt])
  @@index([sensorId, status])
  @@index([predictionId])
  @@map("warnings")
}

model WarningRule {
  id             String            @id @default(uuid()) @db.Uuid
  name           String            @db.VarChar(150)
  sensorType     SensorType        @map("sensor_type")
  parameter      String            @db.VarChar(100)
  unit           String            @db.VarChar(30)
  riskLevel      RiskLevel         @map("risk_level")
  operator       ThresholdOperator
  thresholdValue Float             @map("threshold_value")
  isActive       Boolean           @default(true) @map("is_active")
  createdBy      String            @map("created_by") @db.Uuid
  updatedBy      String?           @map("updated_by") @db.Uuid
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  creator User  @relation("WarningRuleCreator", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Cascade)
  updater User? @relation("WarningRuleUpdater", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([sensorType, parameter, isActive])
  @@map("warning_rules")
}

model Recommendation {
  id                 String               @id @default(uuid()) @db.Uuid
  gateId             String               @map("gate_id") @db.Uuid
  currentOpening     Decimal              @map("current_opening") @db.Decimal(5, 2)
  recommendedOpening Decimal              @map("recommended_opening") @db.Decimal(5, 2)
  reason             String               @db.Text
  supportingData     Json                 @map("supporting_data")
  status             RecommendationStatus @default(PENDING)
  createdBy          String?              @map("created_by") @db.Uuid
  reviewedBy         String?              @map("reviewed_by") @db.Uuid
  reviewedAt         DateTime?            @map("reviewed_at") @db.Timestamptz(6)
  expiresAt          DateTime             @map("expires_at") @db.Timestamptz(6)
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  gate      Gate         @relation(fields: [gateId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  creator   User?        @relation("RecommendationCreator", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Cascade)
  reviewer  User?        @relation("RecommendationReviewer", fields: [reviewedBy], references: [id], onDelete: Restrict, onUpdate: Cascade)
  command   GateCommand?

  @@index([status, expiresAt])
  @@index([gateId, createdAt])
  @@map("recommendations")
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String?  @map("user_id") @db.Uuid
  action       String   @db.VarChar(100)
  resourceType String   @map("resource_type") @db.VarChar(100)
  resourceId   String?  @map("resource_id") @db.Uuid
  oldValues    Json?    @map("old_values")
  newValues    Json?    @map("new_values")
  ipAddress    String?  @map("ip_address") @db.VarChar(64)
  userAgent    String?  @map("user_agent") @db.Text
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([userId, createdAt])
  @@index([resourceType, resourceId])
  @@index([createdAt])
  @@map("audit_logs")
}

model RuntimeConfig {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique @db.VarChar(150)
  value       Json
  description String?  @db.Text
  updatedBy   String?  @map("updated_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  updater User? @relation(fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@map("runtime_configs")
}
